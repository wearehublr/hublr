# Used to build absolute URLs for the sitemap and page metadata.
NEXT_PUBLIC_SITE_URL=https://wearehublr.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The one account allowed into /admin. Must match the email of the user you
# created manually in Supabase Authentication > Users.
ADMIN_EMAIL=you@example.com

# Where admin-facing notification emails (Work With Us submissions, new
# waitlist signups) are sent. Optional - falls back to ADMIN_EMAIL above if
# unset. Kept separate so pointing notifications at a shared inbox never
# risks changing who can log into /admin.
ADMIN_NOTIFICATION_EMAIL=wearehublr@gmail.com

# Shown on /book. Swap this for your own scheduling link any time.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/murielltokam

# Sends an email to ADMIN_EMAIL whenever the Work With Us form is submitted.
# Get a key from resend.com (free tier). Leave unset to skip emailing.
RESEND_API_KEY=re_your_api_key

# Google Analytics measurement ID (from analytics.google.com). Leave unset
# to skip Google Analytics — Vercel Analytics works independently of this.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Service role key from Supabase Project Settings > API. Used only by the
# deadline reminder cron route to read/update applications across all
# users. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret checked against the Authorization header on the cron route,
# so only Vercel's scheduler (which is configured with this same value) can
# trigger it. Generate any long random string.
CRON_SECRET=your-random-secret

# Cloudflare Turnstile keys (dashboard.cloudflare.com > Turnstile > Add site).
# Protects signup/password-reset from bots. Leave both unset to skip
# verification entirely (safe default for local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry error monitoring (sentry.io > new Next.js project > Settings > Client Keys).
# Leave unset to skip error reporting entirely (safe default for local dev).
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Optional: only needed for source-map upload during `next build`, so
# stack traces in Sentry show real file/line instead of minified code.
# Get these from Settings > Auth Tokens (authToken) and your org/project slugs.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Set to "true" in Vercel to redirect every visitor except the admin to
# /waitlist - flip it off (delete it, or set to anything else) and redeploy
# when you're ready to go live. Leave unset locally so you can still see
# the real site while developing. Ignored once LAUNCH_AT (below) is set and
# in the future.
WAITLIST_MODE=true

# ISO datetime (UTC) the site opens itself automatically - no redeploy or
# manual toggle needed, checked fresh on every request. The /api/cron/launch-check
# job (every 15 min) also sends the waitlist's "we're live" email once this
# passes. Remember UK clocks are on BST (UTC+1) from late March to late
# October, so "6am UK time" in that window is 05:00 UTC.
LAUNCH_AT=2026-09-12T05:00:00Z
